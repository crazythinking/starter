#配置自定义Starter的自动化配置
org.springframework.boot.autoconfigure.EnableAutoConfiguration=\
net.engining.minio.autoconfigure.MinioAutoConfiguration,\
net.engining.minio.autoconfigure.MultipleMinioAutoConfiguration,\
net.engining.minio.autoconfigure.MinioActuatorAutoConfiguration,\
net.engining.minio.autoconfigure.MinioWebAutoConfiguration